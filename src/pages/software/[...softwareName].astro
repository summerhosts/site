---
import BaseLayout from "../../layouts/BaseLayout.astro";
import softwareList from "../../data/software.json";
import type { Software } from "../../types/software";
import SoftwareInfo from "../../components/software/SoftwareInfo.astro";

export function getStaticPaths() {
  const paths = [];

  for (const software of softwareList) {
    paths.push({
      params: { softwareName: software.slug },
      props: { software },
    });
  }

  return paths;
}

interface Props {
  software: Software;
}
const { software } = Astro.props;
const { name, iconUrl, bannerUrl, description, references } = software;
---

<BaseLayout title={`${name} | Summerhosts`}>
  {
    bannerUrl ? (
      <img class="banner" src={bannerUrl} />
    ) : (
      <>
        {iconUrl && (
          <div class="header">
            <img src={iconUrl} />
          </div>
        )}
        <h1>{name}</h1>
      </>
    )
  }

  <SoftwareInfo description={description} references={references ?? {}} />
</BaseLayout>

<style>
  .header {
    display: flex;
    flex-direction: column;
  }

  .header img {
    max-height: 2em;
    vertical-align: middle;
    margin-right: 0.5em;
  }

  .banner {
    max-height: 40vh;
    max-width: 50vw;
  }
</style>
