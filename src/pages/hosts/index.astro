---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HostCard from "../../components/host/HostCard.astro";
import type { Host, Parent } from "../../types/hosts";
import rHosts from "../../data/hosts.json";

const hosts = rHosts as unknown as (Host | Parent)[];
---

<BaseLayout title="Hosts list | Summerhosts">
  <div class="hosts-container">
    {
      hosts.map((h) => {
        if ("hosts" in h)
          return h.hosts.map((ch) => <HostCard parent={h} host={ch} />);
        else return <HostCard host={h} />;
      })
    }
  </div>
</BaseLayout>

<style>
  .hosts-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, 20em);
    gap: 1em;
  }
</style>
