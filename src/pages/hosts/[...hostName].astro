---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Events from "../../components/host/HostEvents.astro";
import HostInfo from "../../components/host/HostInfo.astro";
import type { Host, Parent } from "../../types/hosts";
import hosts from "../../data/hosts.json";

export function getStaticPaths() {
  const paths = [];

  for (const host of hosts) {
    if (host.hosts) {
      host.hosts.forEach((h) =>
        paths.push({
          params: { hostName: `${host.slug}/${h.slug}` },
          props: { host: h, parent: host },
        }),
      );
    } else paths.push({ params: { hostName: host.slug }, props: { host } });
  }

  return paths;
}

interface Props {
  host: Host;
  parent?: Parent;
}

const { host, parent } = Astro.props;
const { name, info, bannerUrl } = host;

const fullName = parent ? [parent.name, name].join(" ") : host.name;
---

<BaseLayout title={`${fullName} | Summerhosts`}>
  {
    bannerUrl ? (
      <div class="banner-container">
        <img class="banner" src={bannerUrl} />
      </div>
    ) : (
      <h1>{fullName}</h1>
    )
  }
  <HostInfo info={info} />
  {host.events && <Events events={host.events} />}
</BaseLayout>

<style>
  .banner-container {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .banner {
    max-height: 40vh;
    max-width: 50vw;
  }
</style>
