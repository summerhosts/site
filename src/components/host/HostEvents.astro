---
import type { Events } from "../../types/events";
import Event from "./HostEvent.astro";

interface Props {
  events: Events;
}

const { events } = Astro.props;
---

<h2>Events</h2>
{
  Object.entries(events).map(([timestamp, event]) => (
    <Event event={event} timestamp={timestamp} />
  ))
}
