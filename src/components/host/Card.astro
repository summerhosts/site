---
import type { Host, Parent } from "../../types/hosts";

interface Props {
  host: Host;
  parent: Parent;
}

const { host, parent } = Astro.props;
---

<a
  class="host outline"
  href={`/hosts/${parent ? `${parent.slug}/` : ""}${host.slug}`}
>
  {
    host.bannerUrl && (
      <img src={host.bannerUrl ? host.bannerUrl : parent.bannerUrl} />
    )
  }
  <h1>{parent && `${parent.name} `}{host.name}</h1>
</a>

<style>
  .host {
    display: flex;
    flex-direction: column;
    text-decoration: none;

    align-items: center;

    margin: 0;
    padding: 1em;

    transition: background-color, 100ms;
  }

  .host:hover {
    background-color: var(--tertiary-color);
  }

  .host img {
    border-radius: 20px;
    max-width: 100%;
  }
</style>
