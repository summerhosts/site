---
import type { EventAuthor } from "../../types/events";
import people from "../../data/people.json";

interface Props {
  author: EventAuthor;
}

const { author } = Astro.props;

const authorSlug = people.find((p) =>
  p.socials.discord.find((d) => d.id == author.id),
)?.slug;
---

<i>
  <a href={authorSlug}>
    {author.displayName}, {author.displayName}, <span class="short-code">
      {author.id}
    </span>
  </a>
</i>
