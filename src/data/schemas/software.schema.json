{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hosts",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "iconUrl": {
        "type": "string"
      },
      "bannerUrl": {
        "type": "string"
      },
      "slug": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "versions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "references": {
        "$ref": "reference.schema.json"
      },
      "links": {
        "$ref": "linksList.schema.json"
      }
    },
    "required": [
      "name",
      "slug",
      "description"
    ]
  }
}