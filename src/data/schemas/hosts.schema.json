{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hosts",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "bannerUrl": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "info": {
            "$ref": "linksList.schema.json"
          },
          "events": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "author": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "username": {
                      "type": "string"
                    },
                    "displayName": {
                      "type": "string"
                    }
                  }
                }
              },
              "required": [
                "value"
              ]
            }
          }
        },
        "required": [
          "name",
          "slug",
          "info"
        ]
      },
      {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "hosts": {
            "type": "array",
            "items": {
              "properties": {
                "name": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                },
                "bannerUrl": {
                  "type": "string"
                },
                "info": {
                  "$ref": "linksList.schema.json"
                }
              }
            }
          }
        },
        "required": [
          "name",
          "slug",
          "hosts"
        ]
      }
    ]
  }
}